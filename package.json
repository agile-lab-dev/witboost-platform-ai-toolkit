{
  "name": "witboost-tech-adapter-ai-toolkit",
  "version": "0.1.0",
  "description": "Dedicated toolkit for defining, reviewing, implementing, and testing Witboost tech adapter features end to end",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/agile-lab-dev/witboost-tech-adapter-ai-toolkit.git"
  },
  "homepage": "https://github.com/agile-lab-dev/witboost-tech-adapter-ai-toolkit#readme",
  "bugs": {
    "url": "https://github.com/agile-lab-dev/witboost-tech-adapter-ai-toolkit/issues"
  },
  "scripts": {
    "build": "tsup && node scripts/copy-assets.js",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .witboost/toolkit/src/ .witboost/toolkit/tests/",
    "format": "biome format --write .witboost/toolkit/src/ .witboost/toolkit/tests/",
    "check": "tsc --noEmit",
    "setup": "node .witboost/toolkit/setup.cjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/node": "^22.10.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0",
    "yaml": "^2.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
