{
  "name": "@witboost/ai-toolkit",
  "version": "0.2.0",
  "description": "Domain-oriented agent skills and workspace tooling for Witboost assets",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/AgileFactory/Witboost.Mesh/ai/witboost-tech-adapter-ai-toolkit.git"
  },
  "homepage": "https://gitlab.com/AgileFactory/Witboost.Mesh/ai/witboost-tech-adapter-ai-toolkit",
  "bugs": {
    "url": "https://gitlab.com/AgileFactory/Witboost.Mesh/ai/witboost-tech-adapter-ai-toolkit/-/issues"
  },
  "publishConfig": {
    "registry": "https://gitlab.com/api/v4/projects/85577854/packages/npm/"
  },
  "bin": {
    "witboost-toolkit": "dist/cli.js"
  },
  "files": [
    "dist/",
    "config/scaffolds.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src/ tests/",
    "format": "biome format --write src/ tests/",
    "check": "tsc --noEmit",
    "setup": "node dist/cli.js setup"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/node": "^22.10.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0",
    "yaml": "^2.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
